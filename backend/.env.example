PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/scam_fraud_workspace
JWT_SECRET=generate_a_long_random_secret
JWT_EXPIRES_IN=15m
# Comma-separated frontend origins are supported for local/preview deployments.
CLIENT_URL=http://localhost:5173
# Secret used by trusted external scam-intelligence feeds calling /api/threats/ingest.
THREAT_INGESTION_KEY=generate_a_long_random_ingestion_key

# Optional email alerts (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional SMS alerts (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
